# Copy of the settings the booth needs. `npm run setup` makes a real .env for you.
# Never paste these into a chat, and never commit .env to GitHub.

# The key that unlocks the booth, the photo wall and the slideshow.
BOOTH_KEY=
# A different key for the admin page (guest emails, deleting photos). Keep this one to yourself.
ADMIN_KEY=

# Optional: email guests their photos. Leave blank and guests just scan the QR code.
# RESEND_API_KEY comes from resend.com (free plan is fine).
# EMAIL_FROM must use a domain you've verified in Resend, e.g. Photo Booth <photos@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
